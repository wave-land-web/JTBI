---
import { Font } from 'astro:assets'
import backgroundImage from '../assets/images/textures/jtbi-cloud-background-tan-variant.jpg'
import Footer from '../components/ui/Footer.astro'
import Navigation from '../components/ui/Navigation.astro'
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts'
import { ANNOUNCEMENT_BAR_STORAGE_KEY, getAnnouncementBarId } from '../lib/announcementBar'
import sanityClient from '../sanity/lib/client'
import '../styles/global.css'

// PREVIEW DISABLED: visual editing wiring lives in src/sanity/{lib,presentation},
// src/components/visual-editing, and src/pages/api/draft-mode. To re-enable, see
// NOTES.md → "Sanity preview / visual editing".

export interface Props {
  title?: string
  description?: string
  socialImage?: string
}

interface SiteSettings {
  announcementBar?: {
    active?: boolean
    dismissible?: boolean
    label?: string
    message?: string
    linkText?: string
    href?: string
  }
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, socialImage } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
// TODO: Replace with better social image
const socialImageURL = new URL(socialImage || '/jtbi-logo-primary-90-opacity.png', canonicalURL)
const siteSettings = await sanityClient.fetch<SiteSettings | null>(`
  *[_type == "siteSettings" && _id == "siteSettings"][0]{
    announcementBar{
      active,
      dismissible,
      label,
      message,
      linkText,
      href
    }
  }
`)

// Generate announcement bar ID if announcement bar is active, dismissible, and has a message
const announcementBarId =
  siteSettings?.announcementBar?.active &&
  siteSettings?.announcementBar?.dismissible &&
  siteSettings?.announcementBar?.message
    ? getAnnouncementBarId(siteSettings.announcementBar)
    : undefined
---

<html lang="en" data-theme="corporate">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Facebook -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="840" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={SITE_URL} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Preload Fonts -->
    <Font cssVariable="--font-radio-canada" preload />
    <link rel="stylesheet" href="https://use.typekit.net/fym2duv.css" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="JTBI" />
    <link rel="manifest" href="/site.webmanifest" />
    {
      announcementBarId && (
        <>
          <style is:inline>{`html[data-dismissed-announcement-bar="true"] [data-announcement-bar][data-announcement-id="${announcementBarId}"] {
              display: none;
            }
          `}</style>
          <script
            is:inline
            define:vars={{ announcementBarId, announcementBarStorageKey: ANNOUNCEMENT_BAR_STORAGE_KEY }}
          >
              if (sessionStorage.getItem(announcementBarStorageKey) === announcementBarId) {
                document.documentElement.setAttribute('data-dismissed-announcement-bar', 'true')
              } else {
                document.documentElement.removeAttribute('data-dismissed-announcement-bar')
              }
          </script>
        </>
      )
    }
  </head>

  <body class="relative min-h-screen overflow-x-hidden">
    <div
      class="fixed inset-0 w-full h-auto bg-center bg-cover pointer-events-none z-0 opacity-80"
      style={`background-image: url('${backgroundImage.src}');`}
      role="presentation"
      aria-hidden="true"
    >
    </div>

    <Navigation announcementBar={siteSettings?.announcementBar} />
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Page content with proper z-index -->
    <div class="relative z-10 min-h-screen">
      <slot />
    </div>

    <Footer />
  </body>
</html>

<script>
  import lsa from '../lib/lsa.ts'

  // Initialize LSA animations on page load
  lsa()
</script>
