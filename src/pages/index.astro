---
import { Image } from 'astro:assets'
import PortfolioItem from '../components/ui/PortfolioItem.astro'
import CloudImage from '../assets/images/textures/jtbi-cloud1-80-opacity.png'
import PortfolioImage from '../assets/images/textures/jtbi-cloud-background-horizontal.png'
import PortfolioImageTwo from '../assets/images/textures/jtbi-cloud-background-sample.png'
import CloudImageTwo from '../assets/images/textures/jtbi-cloud2-80-opacity.png'
import ContactForm from '../components/ui/forms/Contact.astro'
import { SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <header class="h-[80dvh] relative flex justify-center items-center">
    <div class="overflow-hidden absolute inset-0 pointer-events-none">
      <Image
        src={CloudImage}
        alt="Cloud texture background"
        class="absolute top-1/2 left-1/2 w-auto h-auto max-w-md opacity-80 cloud-drift-one lsa no-repeat"
        role="presentation"
        loading="eager"
      />
      <Image
        src={CloudImageTwo}
        alt="Secondary cloud texture background"
        class="absolute top-1/2 left-1/2 w-auto h-auto max-w-md opacity-80 cloud-drift-two lsa no-repeat"
        role="presentation"
        loading="eager"
      />
    </div>
    <h1 class="sr-only">{SITE_TITLE}</h1>

    <div class="relative wrapper z-10">
      <h2
        class="text-7xl sm:text-8xl xl:text-9xl text-base-100 font-extrabold lsa no-repeat lsa-slide-up delay-100"
      >
        You're not industry- standard,<br />
        <span
          class="text-5xl sm:text-6xl xl:text-7xl block leading-snug font-normal text-base-content lsa no-repeat lsa-slide-up delay-200"
          >and your branding should prove it.</span
        >
      </h2>
    </div>
  </header>

  <main class="pt-0 text-center">
    <section id="portfolio" class="space-y-8 md:space-y-12">
      <h2 class="text-left lsa lsa-slide-up no-repeat">
        Developing visual and marketing strategies for business acceleration.
      </h2>

      <PortfolioItem
        featureText="<p>We're a full-service brand development and deployment company that helps build value. Our focus is expanding your reach, improving your bottom line, and helping your business consistently look its best.<p>"
        imageSrc={PortfolioImage}
        imageAlt="Atmospheric portfolio sample artwork"
        accentColor="#d94b43"
        title="Portfolio Sample Text."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardTextColor="#013136"
      />

      <h2 class="text-left lsa lsa-slide-up no-repeat mt-16 md:mt-32">
        Can't see the forest for the trees? We help you analyze & refine your brand positioning.
      </h2>
      <PortfolioItem
        reversed={true}
        featureText="<p>We research you and your target markets in relation to your goals, then develop your unique brand identity and help deploy it consistently across the most appropriate marketing channels.</p><p>When you're ready to take the reins, we provide the road map you need, and support you in finding the right in-house talent.</p>"
        imageSrc={PortfolioImageTwo}
        imageAlt="Illustrated portfolio sample collage"
        accentColor="#084F6F"
        title="Portfolio Sample Text."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardBackgroundColor="#084F6F"
        cardTextColor="var(--color-base-100)"
      />

      <h2 class="text-left lsa lsa-slide-up no-repeat mt-16 md:mt-32">
        Your branding needs change over time.
      </h2>
      <PortfolioItem
        featureText="<p>There are three key points when brand identity work is critical:</p><p><strong>Starting Up -</strong> Entrepreneurs and teams looking to launch a new business, idea, or product.</p>"
        imageSrc={PortfolioImageTwo}
        imageAlt="Illustrated portfolio sample collage"
        accentColor="#e05136"
        title="Portfolio Sample Text."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardBackgroundColor="white"
        cardTextColor="#1f193e"
      />
      <PortfolioItem
        featureText="<p><strong>Scaling Up -</strong> An established business looking to expand product lines, services, or enter new markets.</p>"
        imageSrc={PortfolioImageTwo}
        imageAlt="Illustrated portfolio sample collage"
        accentColor="#FFFF00"
        title="Portfolio Sample Text."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardBackgroundColor="white"
        cardTextColor="var(--color-primary)"
      />
      <PortfolioItem
        featureText="<p><strong>Freshening Up -</strong> Long-standing businesses that are seeing more competition in their sector and want to update their look and marketing strategy.</p>"
        imageSrc={PortfolioImageTwo}
        imageAlt="Illustrated portfolio sample collage"
        accentColor="#FFFF00"
        title="Portfolio Sample Text."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardBackgroundColor="transparent"
        cardTextColor="var(--color-primary)"
      />

      <h2 class="text-left lsa lsa-slide-up no-repeat mt-16 md:mt-32">
        Trust builds brands, so trust should be the foundation of brand development.
      </h2>
      <PortfolioItem
        reversed={true}
        featureText="<p>JTBI is entirely guided by owner Jeffrey Baker. You'll always work one-on-one with Jeffrey, and he'll handle all the complexities of compiling and managing a stellar creative team.</p>"
        imageSrc={PortfolioImageTwo}
        imageAlt="Illustrated portfolio sample collage"
        accentColor="#F28095"
        title="Sample Bio Text Teaser."
        description="Nequi tem qui dolore rem corrum iligenda incid etusam, corunt, qui re ex expelent experto con cone labo. Lam, invende pitiatonsed molorru menisci ducium fugit, sequatem velloreprae."
        cardBackgroundColor="white"
        cardTextColor="var(--color-primary)"
      />
    </section>

    <section id="contact">
      <div class="max-w-screen-lg mx-auto text-left">
        <header class="mb-8 text-left">
          <h2 class="h4 text-base-content font-bold mb-2 lsa no-repeat">
            WANT TO DISCUSS YOUR BRAND? <span class="font-normal">Let's chat.</span>
          </h2>
          <p class="lsa no-repeat">
            Whether you're considering refreshing your current branding, or are seeking support with
            the launch of an entirely new business, we're here to help. Contact us for a free
            45-minute consultation.
          </p>
        </header>

        <ContactForm />
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Cloud drift animations */
  @keyframes cloudDriftOne {
    0% {
      transform: translate(-50%, -50%) translateX(-25px);
    }
    50% {
      transform: translate(-50%, -50%) translateX(25px);
    }
    100% {
      transform: translate(-50%, -50%) translateX(-25px);
    }
  }

  .cloud-drift-one {
    animation: cloudDriftOne 12s ease-in-out infinite;
  }

  .cloud-drift-two {
    animation: cloudDriftOne 15s ease-in-out infinite;
  }
</style>
