---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/ui/PageHeader.astro'
import MediaCardRow from '../components/ui/MediaCardRow.astro'
import Card from '../components/ui/Card.astro'
import ContactBg from '../assets/images/textures/jtbi-cloud-background-sample.svg'
import ContactForm from '../components/ui/forms/Contact.astro'
import { sanityClient } from '../sanity/lib/client'
import { urlForImage } from '../sanity/lib/urlForImage'
import { toHTML } from '@portabletext/to-html'
import { SITE_TITLE } from '../consts'
import type { PageBlock } from '../sanity/lib/types'

const homepage = await sanityClient.fetch(
  `*[_id == "homepage"][0]{
    pageBuilder[]{
      _type,
      _key,
      _type == "heroBlock" => {
        sectionId,
        backgroundImage {
          asset->{ _id, url },
          alt
        },
        carouselImages[] {
          asset->{ _id, url },
          alt
        },
        headline1,
        headline1Color,
        headline2,
        headline2Color
      },
      _type == "projectsBlock" => {
        sectionId,
        heading,
        projects[]-> {
          _id,
          title,
          description,
          featureText,
          image,
          href,
          ctaLabel,
          reversed,
          styling
        }
      },
      _type == "mediaCardRowBlock" => {
        sectionId,
        heading,
        featureText,
        title,
        description,
        image,
        href,
        ctaLabel,
        reversed,
        styling
      },
      _type == "servicesBlock" => {
        sectionId,
        heading,
        items
      },
      _type == "contactBlock" => {
        sectionId,
        heading,
        subheading,
        subheadingAccent,
        body
      }
    }
  }`,
)

const blocks: PageBlock[] = homepage?.pageBuilder ?? []
---

<Layout>
  {
    blocks.map((block) => {
      if (block._type === 'heroBlock') {
        const carouselImages = (block.carouselImages ?? [])
          .filter((img) => img.asset)
          .map((img) => ({
            src: urlForImage(img).width(1920).url(),
            alt: img.alt || '',
          }))

        return (
          <PageHeader
            id={block.sectionId}
            carouselImages={carouselImages.length > 0 ? carouselImages : undefined}
            backgroundImageSrc={
              carouselImages.length === 0 && block.backgroundImage?.asset
                ? urlForImage(block.backgroundImage).width(1920).url()
                : undefined
            }
            backgroundImageAlt={block.backgroundImage?.alt}
            headline1={block.headline1 || "You're not industry-standard,"}
            headline1Color={block.headline1Color}
            headline2={block.headline2 || 'and your branding should prove it.'}
            headline2Color={block.headline2Color}
            srTitle={SITE_TITLE}
          />
        )
      }
      return null
    })
  }

  <main>
    {
      blocks.map((block) => {
        if (block._type === 'projectsBlock') {
          const projects = block.projects ?? []
          return (
            <section id={block.sectionId || undefined} class="text-center flex flex-col gap-8">
              <h2 class="text-left lsa lsa-slide-up no-repeat">
                {block.heading ||
                  'Developing visual and marketing strategies for business acceleration.'}
              </h2>
              {projects.map((project) => (
                <MediaCardRow
                  featureText={toHTML(project.featureText)}
                  reversed={project.reversed}
                  imageSrc={project.image ? urlForImage(project.image).width(800).url() : undefined}
                  imageAlt={project.image?.alt || 'Portfolio preview image'}
                  accentColor={project.styling?.accentColor}
                  cardBackgroundColor={project.styling?.cardBackgroundColor}
                  cardTextColor={project.styling?.cardTextColor}
                  title={project.title}
                  description={project.description}
                  href={project.href}
                  ctaLabel={project.ctaLabel}
                />
              ))}
            </section>
          )
        }

        if (block._type === 'mediaCardRowBlock') {
          return (
            <section id={block.sectionId || undefined} class="text-center flex flex-col gap-8">
              {block.heading && (
                <h2 class="text-left lsa lsa-slide-up no-repeat">{block.heading}</h2>
              )}
              <MediaCardRow
                reversed={block.reversed}
                featureText={block.featureText ? toHTML(block.featureText) : ''}
                imageSrc={block.image ? urlForImage(block.image).width(800).url() : undefined}
                imageAlt={block.image?.alt || ''}
                accentColor={block.styling?.accentColor}
                cardBackgroundColor={block.styling?.cardBackgroundColor}
                cardTextColor={block.styling?.cardTextColor}
                title={block.title || ''}
                description={block.description || ''}
                href={block.href}
                ctaLabel={block.ctaLabel}
              />
            </section>
          )
        }

        if (block._type === 'servicesBlock') {
          return (
            <section id={block.sectionId || undefined} class="text-center">
              <div class="flex flex-col gap-8 md:gap-10">
                <h2 class="h3 uppercase text-left text-primary lsa lsa-slide-up no-repeat">
                  {block.heading || 'Services We Offer'}
                </h2>
                <div class="grid md:grid-cols-3 gap-8 md:gap-10">
                  {block.items?.map((item) => {
                    // Generate inline styles for card based on its styling properties, w/ fallbacks to CSS variables or defaults
                    const cardStyles = `
                      --card-accent: ${item.accentColor || 'var(--color-primary)'};
                      --card-bg: ${item.cardBackgroundColor || item.accentColor};
                      --card-text: ${item.cardTextColor || item.accentColor || 'var(--color-primary)'};
                      --card-cta: ${item.cardTextColor || item.accentColor || 'var(--color-primary)'};
                      --card-media-bg: ${item.mediaBackgroundColor || 'var(--color-base-200)'};
                      --card-divider: color-mix(in srgb, ${item.cardTextColor || item.accentColor || 'var(--color-primary)'} 14%, transparent);
                    `
                    return (
                      <div class="service-card lsa no-repeat w-full" style={cardStyles}>
                        <Card
                          title={item.title}
                          description={item.description}
                          href={item.href || '#contact'}
                          ctaLabel={item.ctaLabel || 'Read More'}
                          imageSrc={
                            item.image ? urlForImage(item.image).width(1000).url() : undefined
                          }
                          imageAlt={
                            item.image?.alt ||
                            `JTB Imaginative logo mark for ${item.title.toLowerCase()}`
                          }
                          imageAspect="square"
                          imageClass="relative z-10"
                          mediaClass="bg-(--card-media-bg)"
                          contentClass="flex flex-col gap-2.5 p-4 text-left sm:p-5 bg-(--card-bg)"
                          class="h-full border-(--card-divider) text-(--card-text)"
                          accentBorderColor={item.accentColor || 'var(--color-primary)'}
                        />
                      </div>
                    )
                  })}
                </div>
              </div>
            </section>
          )
        }

        if (block._type === 'contactBlock') {
          return (
            <section id={block.sectionId || undefined} class="relative max-w-none bg-primary">
              <div
                style={`background-image: url(${ContactBg.src}); background-size: cover; background-position: center;`}
                class="absolute inset-0 opacity-10 pointer-events-none"
                role="presentation"
              />
              <div class="wrapper text-left">
                <header class="space-y-4 mb-8 py-0 text-left relative z-10">
                  <h2 class="lsa lsa-slide-up no-repeat">
                    {block.heading || 'Brand building that means business.'}
                  </h2>
                  <h3 class="text-primary-content lsa lsa-slide-up no-repeat delay-100">
                    {block.subheading || 'WANT TO DISCUSS YOUR BRAND?'}
                    <span>{block.subheadingAccent || "Let's chat."}</span>
                  </h3>
                  <p class="text-base-200 font-bold lsa lsa-slide-up no-repeat delay-200">
                    {block.body ||
                      "Whether you're considering refreshing your current branding, or are seeking support with the launch of an entirely new business, we're here to help. Contact us for a free 45-minute consultation."}
                  </p>
                </header>
                <ContactForm />
              </div>
            </section>
          )
        }

        return null
      })
    }
  </main>
</Layout>
