---
import { toHTML } from '@portabletext/to-html'
import type { TypedObject } from '@portabletext/types'
import Button from '../../components/ui/Button.astro'
import PageHeader from '../../components/ui/PageHeader.astro'
import Layout from '../../layouts/Layout.astro'
import { getDraftModeProps } from '../../sanity/lib/draftMode'
import { loadQuery } from '../../sanity/lib/loadQuery'

export const prerender = false

const { slug } = Astro.params

interface LegalPage {
  title: string
  body?: TypedObject | TypedObject[]
  seoDescription?: string
}

const { data: page } = await loadQuery<LegalPage | null>({
  query: `*[_type == "legalPage" && slug.current == $slug][0]{
    title,
    body,
    seoDescription
  }`,
  params: { slug },
  ...getDraftModeProps(Astro.cookies),
})

if (!page) {
  return Astro.redirect('/404')
}
---

<Layout title={`${page.title} | JTB Imaginative LLC`} description={page.seoDescription || ''}>
  <PageHeader
    eyebrow="Legal"
    title={page.title}
    fullHeight={false}
    headerClass="text-center"
    contentClass="flex flex-col items-center"
  />
  {
    page.body && (
      <main id="main-content" class="wrapper prose py-(--site-padding-3xl)">
        <Fragment set:html={toHTML(page.body)} />
        <Button label="Back to Home" href="/" wrapperClass="mt-8" tagClass="no-underline" />
      </main>
    )
  }
</Layout>
