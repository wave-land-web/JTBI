---
import { toHTML } from '@portabletext/to-html'
import type { PortableTextBlock, TypedObject } from '@portabletext/types'
import Card from '../../components/ui/Card.astro'
import ImageGallery from '../../components/ui/ImageGallery.astro'
import MasonryGrid from '../../components/ui/MasonryGrid.astro'
import MediaCardRow from '../../components/ui/MediaCardRow.astro'
import MuxVideo from '../../components/ui/MuxVideo.astro'
import OverviewCard from '../../components/ui/OverviewCard.astro'
import PageHeader from '../../components/ui/PageHeader.astro'
import SanityImg from '../../components/ui/SanityImage.astro'
import SixUpMasonryGrid from '../../components/ui/SixUpMasonryGrid.astro'
import Layout from '../../layouts/Layout.astro'
import { clamp } from '../../lib/clamp'
import { getDraftModeProps } from '../../sanity/lib/draftMode'
import { loadQuery } from '../../sanity/lib/loadQuery'
import { imageWithAlt, mediaArrayMember, muxVideoWithMeta } from '../../sanity/lib/queries'
import type { MuxVideo as MuxVideoData, SanityMediaItem } from '../../sanity/lib/types'
import { hasAsset, toPicture, toPictureCropped } from '../../sanity/lib/urlForImage'
import { type MediaItem, toMediaItems, toVideo, videoPosterCropped } from '../../sanity/lib/video'
import { SIX_UP_CELLS, sixUpVideoAltKey, sixUpVideoKey } from '../../sanity/schemaTypes/shared/gridFilled'

// --- Types ---------------------------------------------------------------

interface SanityImage {
  asset?: { _ref: string; _type: string } | null
  alt?: string
}

interface Styling {
  accentColor?: string
  cardBackgroundColor?: string
  cardTextColor?: string
}

interface MediaCardRowBlock extends TypedObject {
  _type: 'mediaCardRowBlock'
  title?: string
  description?: string
  featureText?: PortableTextBlock[]
  image?: SanityImage
  video?: MuxVideoData
  href?: string
  ctaLabel?: string
  reversed?: boolean
  styling?: Styling
}

interface ImageGalleryBlock extends TypedObject {
  _type: 'imageGalleryBlock'
  images?: SanityMediaItem[]
  columns?: number
  fullWidth?: boolean
}

type BodyBlock = PortableTextBlock | MediaCardRowBlock | ImageGalleryBlock

interface RelatedProject {
  _id: string
  title: string
  description?: string
  cardImage?: SanityImage
  cardVideo?: MuxVideoData
  href?: string
  slug?: { current: string }
  styling?: Styling
}

interface MasonryGridData {
  hidden?: boolean
  images?: SanityMediaItem[]
}

interface SixUpGridData {
  hidden?: boolean
  topWide?: SanityImage
  centerTall?: SanityImage
  topRight?: SanityImage
  bottomLeft?: SanityImage
  bottomMidLeft?: SanityImage
  bottomRight?: SanityImage
  topWideVideo?: MuxVideoData
  centerTallVideo?: MuxVideoData
  topRightVideo?: MuxVideoData
  bottomLeftVideo?: MuxVideoData
  bottomMidLeftVideo?: MuxVideoData
  bottomRightVideo?: MuxVideoData
  topWideVideoAlt?: string
  centerTallVideoAlt?: string
  topRightVideoAlt?: string
  bottomLeftVideoAlt?: string
  bottomMidLeftVideoAlt?: string
  bottomRightVideoAlt?: string
}

interface Project {
  title: string
  cardImage?: SanityImage
  cardVideo?: MuxVideoData
  heroImage?: SanityImage
  heroVideo?: MuxVideoData
  styling?: Styling
  projectOverview?: PortableTextBlock[]
  masonryGrid?: MasonryGridData
  sixUpGrid?: SixUpGridData
  body?: BodyBlock[]
  relatedProjects?: RelatedProject[]
  hideRelatedProjects?: boolean
}

type BodyGroup =
  | { type: 'text'; blocks: PortableTextBlock[] }
  | { type: 'mediaCardRow'; blocks: [MediaCardRowBlock] }
  | { type: 'imageGallery'; blocks: [ImageGalleryBlock] }

// --- Data ----------------------------------------------------------------

export async function getStaticPaths() {
  // Build-time path enumeration — always published (only ship pages for
  // published projects, never draft-only ones).
  const { data: projects } = await loadQuery<{ slug: string }[]>({
    query: `*[_type == "project"]{ "slug": slug.current }`,
  })
  return projects.map((p) => ({ params: { slug: p.slug } }))
}

const { slug } = Astro.params

// Shared projection for related project cards
const relatedProjectFields = `{
  _id,
  title,
  description,
  cardImage ${imageWithAlt},
  cardVideo ${muxVideoWithMeta},
  href,
  slug,
  styling
}`

const { data: project } = await loadQuery<Project | null>({
  query: `*[_type == "project" && slug.current == $slug][0]{
    title,
    cardImage ${imageWithAlt},
    cardVideo ${muxVideoWithMeta},
    heroImage ${imageWithAlt},
    heroVideo ${muxVideoWithMeta},
    styling,
    projectOverview,
    masonryGrid {
      hidden,
      "images": images[
        (_type == "image" && defined(asset)) ||
        (_type == "videoItem" && defined(video.asset))
      ] ${mediaArrayMember}
    },
    sixUpGrid {
      hidden,
      topWide ${imageWithAlt},
      centerTall ${imageWithAlt},
      topRight ${imageWithAlt},
      bottomLeft ${imageWithAlt},
      bottomMidLeft ${imageWithAlt},
      bottomRight ${imageWithAlt},
      topWideVideo ${muxVideoWithMeta},
      centerTallVideo ${muxVideoWithMeta},
      topRightVideo ${muxVideoWithMeta},
      bottomLeftVideo ${muxVideoWithMeta},
      bottomMidLeftVideo ${muxVideoWithMeta},
      bottomRightVideo ${muxVideoWithMeta},
      topWideVideoAlt,
      centerTallVideoAlt,
      topRightVideoAlt,
      bottomLeftVideoAlt,
      bottomMidLeftVideoAlt,
      bottomRightVideoAlt
    },
    body[]{
      ...,
      _type == "imageGalleryBlock" => {
        ...,
        "images": images[
          (_type == "image" && defined(asset)) ||
          (_type == "galleryVideoItem" && defined(video.asset))
        ] ${mediaArrayMember}
      },
      _type == "mediaCardRowBlock" => {
        ...,
        image ${imageWithAlt},
        "video": video ${muxVideoWithMeta}
      }
    },
    hideRelatedProjects,
    "relatedProjects": relatedProjects[]->${relatedProjectFields}
  }`,
  params: { slug },
  ...getDraftModeProps(Astro.cookies),
})

if (!project) {
  return Astro.redirect('/404')
}

// --- Helpers -------------------------------------------------------------

const heroSource = project.heroImage || project.cardImage
const heroImg = hasAsset(heroSource) ? toPicture(heroSource, 2400) : undefined

// Ambient hero video — heroVideo falls back to cardVideo (mirroring the image
// fallback). Plays only when ready; otherwise the image hero renders as before.
const heroVideo = toVideo(project.heroVideo ?? project.cardVideo, 1600, heroImg?.alt ?? '')
if (heroVideo && heroImg) heroVideo.poster = heroImg.src

const masonryItems = toMediaItems(project.masonryGrid?.images, 800)

// A cell is filled by its video (when ready) or its image; the grid renders
// only when all 6 cells resolve.
const sixUpItems: MediaItem[] = []
for (const key of SIX_UP_CELLS) {
  const img = project.sixUpGrid?.[key]
  const videoAlt = project.sixUpGrid?.[sixUpVideoAltKey(key)]
  const video = toVideo(project.sixUpGrid?.[sixUpVideoKey(key)], 800, videoAlt || img?.alt || '')
  if (video) sixUpItems.push({ kind: 'video', ...video })
  else if (hasAsset(img)) sixUpItems.push({ kind: 'image', ...toPicture(img, 800) })
}

const showSixUp = sixUpItems.length === 6 && project.sixUpGrid?.hidden !== true
const showMasonry = !showSixUp && masonryItems.length > 0 && project.masonryGrid?.hidden !== true

const overviewTextBlocks = (project.projectOverview ?? []).filter(
  (b): b is PortableTextBlock => b._type === 'block',
)

const overviewStyleProps = {
  accentColor: project.styling?.accentColor,
  backgroundColor: project.styling?.cardBackgroundColor,
  textColor: project.styling?.cardTextColor,
}

// Group body blocks into consecutive runs of text vs non-text blocks so
// adjacent portable-text segments render under one prose container.
const bodyGroups: BodyGroup[] = []
for (const block of project.body ?? []) {
  if (block._type === 'mediaCardRowBlock') {
    bodyGroups.push({ type: 'mediaCardRow', blocks: [block as MediaCardRowBlock] })
  } else if (block._type === 'imageGalleryBlock') {
    bodyGroups.push({ type: 'imageGallery', blocks: [block as ImageGalleryBlock] })
  } else {
    const last = bodyGroups[bodyGroups.length - 1]
    if (last?.type === 'text') last.blocks.push(block as PortableTextBlock)
    else bodyGroups.push({ type: 'text', blocks: [block as PortableTextBlock] })
  }
}

const getCardVars = (styling: Styling = {}) => {
  const accent = styling.accentColor || 'var(--color-primary)'
  const text = styling.cardTextColor || styling.accentColor || 'var(--color-primary)'
  const bg = styling.cardBackgroundColor || styling.accentColor
  const mediaBg = styling.cardBackgroundColor || styling.accentColor || 'var(--color-base-200)'
  return `
    --card-accent: ${accent};
    --card-bg: ${bg};
    --card-text: ${text};
    --card-cta: ${text};
    --card-media-bg: ${mediaBg};
    --card-divider: color-mix(in srgb, ${text} 14%, transparent);
  `
}
---

<Layout title={`${project.title} | JTB Imaginative LLC`}>
  <PageHeader title={project.title} contentClass="items-start gap-0!" headerClass="pb-0">
    {
      !heroImg && !heroVideo && overviewTextBlocks.length > 0 && (
        <OverviewCard
          overview={overviewTextBlocks}
          {...overviewStyleProps}
          class="mt-(--site-padding-base)"
        />
      )
    }
  </PageHeader>

  {
    (heroVideo || heroImg) && (
      <div class="project-hero relative mt-(--site-padding-base) md:mt-(--site-padding-sm)">
        {heroVideo ? (
          <MuxVideo
            playbackId={heroVideo.playbackId}
            mode="ambient"
            aspectRatio={heroVideo.aspectRatio}
            poster={heroVideo.poster}
            class="w-full lsa no-repeat"
          />
        ) : (
          heroImg && (
            <SanityImg
              src={heroImg.src}
              alt={heroImg.alt}
              class="w-full h-auto lsa no-repeat object-cover"
              width={heroImg.width}
              height={heroImg.height}
              priority
            />
          )
        )}
        {overviewTextBlocks.length > 0 && (
          <OverviewCard
            overview={overviewTextBlocks}
            {...overviewStyleProps}
            class="project-hero__overview"
          />
        )}
      </div>
    )
  }

  {showSixUp && <SixUpMasonryGrid images={sixUpItems} />}
  {showMasonry && <MasonryGrid images={masonryItems} />}

  <main id="main-content" class="section space-y-6">
    {
      bodyGroups.map((group) => {
        if (group.type === 'mediaCardRow') {
          const block = group.blocks[0]
          const blockImg = hasAsset(block.image) ? toPicture(block.image, 1600) : undefined
          const blockVideo = toVideo(block.video, 1600)
          return (
            <div class="py-(--site-padding-md)">
              <MediaCardRow
                reversed={block.reversed}
                featureText={block.featureText ? toHTML(block.featureText) : ''}
                imageSrc={blockImg?.src}
                imageWidth={blockImg?.width}
                imageHeight={blockImg?.height}
                imageAlt={blockImg?.alt || ''}
                video={blockVideo}
                accentColor={block.styling?.accentColor}
                cardBackgroundColor={block.styling?.cardBackgroundColor}
                cardTextColor={block.styling?.cardTextColor}
                title={block.title || ''}
                description={block.description || ''}
                href={block.href}
                ctaLabel={block.ctaLabel}
              />
            </div>
          )
        }
        if (group.type === 'imageGallery') {
          const block = group.blocks[0]
          const galleryColumns = block.columns ?? 5
          // Each col/row unit is 800px of source image — generous for retina
          // on any realistic viewport without producing oversized files for
          // multi-cell features.
          const GALLERY_UNIT = 800
          const galleryItems = (block.images ?? []).flatMap((item): MediaItem[] => {
            const cols = clamp(1, item.colSpan ?? 1, galleryColumns)
            const rows = clamp(1, item.rowSpan ?? 1, 4)
            const cellW = cols * GALLERY_UNIT
            const cellH = rows * GALLERY_UNIT
            const spans = { colSpan: item.colSpan ?? undefined, rowSpan: item.rowSpan ?? undefined }
            if (item._type === 'image') {
              if (!hasAsset(item)) return []
              return [{ kind: 'image' as const, ...toPictureCropped(item, cellW, cellH), ...spans }]
            }
            const video = toVideo(item.video, cellW, item.alt ?? '')
            if (!video) return []
            // Crop the tile poster to the cell like toPictureCropped does for
            // images, but keep the native-aspect poster for the lightbox player.
            const lightboxPoster = video.poster
            video.poster = videoPosterCropped(video.playbackId, cellW, cellH)
            video.height = cellH
            return [{ kind: 'video' as const, ...video, lightboxPoster, ...spans }]
          })
          return (
            <div class="py-(--site-padding-md)">
              <ImageGallery
                images={galleryItems}
                columns={galleryColumns}
                fullWidth={block.fullWidth ?? true}
              />
            </div>
          )
        }
        return (
          <div class="max-w-4xl ml-auto space-y-6 lsa no-repeat">
            <Fragment set:html={toHTML(group.blocks)} />
          </div>
        )
      })
    }

    {
      project.hideRelatedProjects !== true &&
        project.relatedProjects &&
        project.relatedProjects.length > 0 && (
          <section class="text-center px-0">
            <div class="flex flex-col gap-8 md:gap-10">
              <h2 class="h3 uppercase text-left text-primary lsa lsa-slide-up no-repeat">
                Related Projects
              </h2>
              <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-[clamp(40px,4vw,64px)]">
                {project.relatedProjects.map((related) => {
                  const relImg = hasAsset(related.cardImage)
                    ? toPicture(related.cardImage, 1000)
                    : undefined
                  const relVideo = toVideo(related.cardVideo, 1000)
                  const relHref = related.slug?.current
                    ? `/project/${related.slug.current}`
                    : related.href || '#'
                  return (
                    <div class="lsa no-repeat w-full" style={getCardVars(related.styling)}>
                      <Card
                        title={related.title}
                        description={related.description || ''}
                        href={relHref}
                        ctaLabel="View Project"
                        imageSrc={relImg?.src}
                        imageWidth={relImg?.width}
                        imageHeight={relImg?.height}
                        imageAlt={relImg?.alt || related.title}
                        video={relVideo}
                        imageClass="relative z-10 h-full w-full object-cover"
                        mediaClass="bg-(--card-media-bg) aspect-video"
                        contentClass="flex h-full flex-col gap-2.5 p-4 text-left sm:p-5 bg-(--card-bg)"
                        class="h-full border-(--card-divider) text-(--card-text)"
                        accentBorderColor={related.styling?.accentColor || 'var(--color-primary)'}
                      />
                    </div>
                  )
                })}
              </div>
            </div>
          </section>
        )
    }
  </main>
</Layout>

<style>
  .project-hero :global(.project-hero__overview) {
    display: block;
    max-width: var(--nav-width);
    margin: auto;
  }

  @media (min-width: 768px) {
    .project-hero {
      padding-top: var(--site-padding-lg);
    }

    .project-hero :global(.project-hero__overview) {
      position: absolute;
      inset: 0 0 auto 0;
      z-index: 10;
      padding: 0 var(--site-padding-base);
    }

    main :global(.portfolio-item) {
      grid-template-columns: 1fr minmax(0, 56rem);
    }

    main :global(.portfolio-item--reversed) {
      grid-template-columns: minmax(0, 56rem) 1fr;
    }
  }
</style>
