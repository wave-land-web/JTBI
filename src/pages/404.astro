---
import PageHeader from '../components/ui/PageHeader.astro'
import { SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
import { sanityClient } from '../sanity/lib/client'
import { urlForImage } from '../sanity/lib/urlForImage'

const page = await sanityClient.fetch(
  `*[_id == "notFoundPage"][0]{
    heading,
    message,
    ctaLabel,
    ctaHref,
    backgroundImage {
      asset->{ _id, url },
      alt
    }
  }`,
)

const heading = page?.heading || '404'
const message = page?.message || 'The page you are looking for could not be found.'
const ctaLabel = page?.ctaLabel || 'Back to Site'
const ctaHref = page?.ctaHref || '/'
const bgSrc = page?.backgroundImage?.asset
  ? urlForImage(page.backgroundImage).width(1920).url()
  : undefined
const bgAlt = page?.backgroundImage?.alt || ''
---

<Layout title={`404 - ${SITE_TITLE}`} description="Page not found.">
  <PageHeader
    backgroundImageSrc={bgSrc}
    backgroundImageAlt={bgAlt}
    srTitle={SITE_TITLE}
    title={heading}
    message={message}
    ctaLabel={ctaLabel}
    ctaHref={ctaHref}
    headerClass="text-center"
    fullHeight={false}
  />
</Layout>
