  <header class="wrapper">
    <h1>H1 - Factoria Light</h1>
    <h2>H2 - Factoria Bold</h2>
    <h3>H3 - Factoria Bold</h3>
    <h4>H4 - Radio Canada Semibold</h4>
    <h5>H5 - Supporting Heading</h5>
    <h6>H6 - Navigation - Radio Canada Semibold</h6>
    <p>Body Reference</p>
    <p>P1 - Radio Canada Light</p>
    <p class="p2">P2 - Radio Canada Regular</p>
    <p class="p3">P3 (Caption) - Factoria Medium</p>
  </header>
</Layout>
