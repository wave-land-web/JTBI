---
import { Image } from 'astro:assets'
import AnnouncementBar from './AnnouncementBar.astro'
import JTBILogoPrimary from '../../assets/images/logos/jtbi-logo-primary.svg'
import CloudTexture from '../../assets/images/textures/jtbi-cloud1-80-opacity.png'

interface AnnouncementBarData {
  active?: boolean
  dismissible?: boolean
  label?: string
  message?: string
  linkText?: string
  href?: string
}

export interface Props {
  announcementBar?: AnnouncementBarData
}

const links = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio', href: '/#portfolio' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
]

const { announcementBar } = Astro.props
const currentPath = Astro.url.pathname
const logoLinkClasses = 'relative block overflow-visible group'
const logoTextureClasses =
  'pointer-events-none absolute top-1/2 h-[160%] w-full -translate-y-1/2 opacity-60 object-contain transition-opacity duration-200 group-hover:opacity-80 pointer-events-none'
const desktopLinkClasses =
  'rounded-box px-3 py-2 text-sm md:text-base text-base-300 font-extrabold uppercase tracking-wide transition-colors duration-200 hover:bg-base-100/10 hover:text-base-100 focus-visible:bg-base-100/10 focus-visible:text-base-100'
const mobileLinkClasses =
  'rounded-box px-3 py-2 text-sm font-extrabold uppercase tracking-wide text-base-300 transition-colors duration-200 hover:bg-base-100/10 hover:text-base-100 focus:bg-base-100/10 focus:text-base-100!  focus-visible:bg-base-100/10! focus-visible:text-base-100!'
const activeLinkClasses = 'text-base-100!'

const isActiveLink = (href: string) => href === '/' && currentPath === '/'

const getLinkClasses = (variant: 'desktop' | 'mobile', href: string) => [
  variant === 'desktop' ? desktopLinkClasses : mobileLinkClasses,
  isActiveLink(href) ? activeLinkClasses : undefined,
]
---

<nav
  id="main-navigation"
  class="sticky top-0 z-30 text-base-100 transition-transform duration-300 ease-in-out -translate-y-full active [&.active]:translate-y-0"
  aria-label="Primary"
>
  <div class="bg-primary">
    <div class="wrapper">
      <!-- Mobile Navigation -->
      <div class="navbar min-h-0 px-0 py-5 md:hidden">
        <div class="navbar-start">
          <a href="/" class:list={[logoLinkClasses, 'w-36']} aria-label="JTB Imaginative home">
            <Image
              src={CloudTexture}
              alt="Cloud texture background"
              aria-hidden="true"
              class={logoTextureClasses}
            />
            <JTBILogoPrimary class="relative z-10 block w-full" />
          </a>
        </div>

        <div class="navbar-end">
          <div class="dropdown">
            <button
              type="button"
              tabindex="0"
              class="btn btn-ghost btn-xs text-base-300 hover:bg-base-100/10 hover:text-base-100 focus-visible:bg-base-100/10 focus-visible:text-base-100"
              aria-label="Open navigation menu"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                class="size-7"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h10"
                ></path>
              </svg>
            </button>
            <ul
              tabindex="0"
              class="bg-primary menu menu-sm dropdown-content rounded-box z-40 right-0 mt-4 w-56 border border-base-100/10 p-3 shadow-xl"
              role="list"
            >
              {
                links.map((link) => (
                  <li>
                    <a href={link.href} class:list={getLinkClasses('mobile', link.href)}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div
        class="max-w-(--nav-width) mx-auto hidden items-center justify-between gap-6 py-8 md:flex"
      >
        <a
          href="/"
          class:list={[logoLinkClasses, 'w-44 md:w-48']}
          aria-label="JTB Imaginative home"
        >
          <Image
            src={CloudTexture}
            alt="Cloud texture background"
            aria-hidden="true"
            class={logoTextureClasses}
          />
          <JTBILogoPrimary class="relative z-10 block w-full" />
        </a>

        <ul class="flex flex-wrap items-center justify-center gap-4" role="list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class:list={getLinkClasses('desktop', link.href)}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <AnnouncementBar
    active={announcementBar?.active}
    dismissible={announcementBar?.dismissible}
    label={announcementBar?.label}
    message={announcementBar?.message}
    linkText={announcementBar?.linkText}
    href={announcementBar?.href}
  />
</nav>

<script>
  const nav: HTMLElement | null = document.getElementById('main-navigation')

  if (nav) {
    let lastScrollY = window.scrollY
    const minDelta = 8

    const updateNavState = () => {
      const currentScrollY = window.scrollY
      const delta = currentScrollY - lastScrollY

      if (currentScrollY <= 0) {
        nav.classList.add('active')
        lastScrollY = 0
        return
      }

      if (Math.abs(delta) < minDelta) {
        return
      }

      if (delta > 0) {
        nav.classList.remove('active')
      } else {
        nav.classList.add('active')
      }

      lastScrollY = currentScrollY
    }

    window.addEventListener('scroll', updateNavState, { passive: true })
  }
</script>
