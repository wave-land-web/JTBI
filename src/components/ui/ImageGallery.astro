---
import { Picture } from 'astro:assets'

export interface GalleryImage {
  src: string
  width: number
  height: number
  alt: string
}

interface Props {
  images: GalleryImage[]
  columns?: number
  fullWidth?: boolean
  class?: string
}

const { images, columns = 5, fullWidth = true, class: className } = Astro.props
---

{
  images.length > 0 && (
    <div class:list={[fullWidth && 'full-bleed', className]}>
      <div
        class="grid grid-cols-2 gap-1 md:grid-cols-(--gallery-cols)"
        style={`--gallery-cols: repeat(${columns}, minmax(0, 1fr));`}
      >
        {images.map((img, i) => (
          <div
            class="aspect-square overflow-hidden bg-base-200 lsa lsa-slide-up no-repeat"
            style={`transition-delay: ${Math.min(i, 8) * 60}ms`}
          >
            <Picture
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              formats={['avif', 'webp']}
              quality={85}
              class="w-full h-full block object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  )
}
