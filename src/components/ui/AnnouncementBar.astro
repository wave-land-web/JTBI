---
import { ANNOUNCEMENT_BAR_STORAGE_KEY, getAnnouncementBarId } from '../../lib/announcementBar'

export interface Props {
  active?: boolean
  dismissible?: boolean
  label?: string
  message?: string
  linkText?: string
  href?: string
}

const { active = false, dismissible = false, label, message, linkText, href } = Astro.props
const announcementId = getAnnouncementBarId({ label, message, linkText, href })
---

{
  active && message && (
    <div
      class="bg-secondary text-secondary-content"
      data-announcement-bar
      data-announcement-id={announcementId}
    >
      <div class="relative flex flex-wrap items-center justify-center gap-2 py-3 pr-12 pl-4 text-center text-xs uppercase tracking-wide sm:px-12 sm:text-sm">
        {label && <span class="font-bold">{label}</span>}
        <span class="normal-case tracking-normal text-balance">{message}</span>
        {linkText && href && (
          <a href={href} class="link link-primary">
            {linkText}
          </a>
        )}
        {dismissible && (
          <div class="absolute top-1/2 right-3 -translate-y-1/2">
            <button
              type="button"
              class="btn btn-ghost btn-circle btn-xs border border-secondary-content/30 text-secondary-content hover:border-secondary-content/50 hover:bg-secondary-content/10"
              aria-label="Dismiss announcement"
              data-announcement-close
            >
              <svg
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="size-3.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </div>
  )
}

<script define:vars={{ announcementBarStorageKey: ANNOUNCEMENT_BAR_STORAGE_KEY }}>
  const setupAnnouncementBars = () => {
    const announcementBars = document.querySelectorAll('[data-announcement-bar]')

    announcementBars.forEach((announcementBar) => {
      const announcementId = announcementBar.dataset.announcementId
      const closeButton = announcementBar.querySelector('[data-announcement-close]')

      if (!announcementId) {
        return
      }

      try {
        announcementBar.hidden =
          sessionStorage.getItem(announcementBarStorageKey) === announcementId
      } catch {
        announcementBar.hidden = false
      }

      if (!closeButton || closeButton.dataset.bound === 'true') {
        return
      }

      closeButton.dataset.bound = 'true'
      closeButton.addEventListener('click', () => {
        announcementBar.hidden = true
        document.documentElement.dataset.dismissedAnnouncementBar = 'true'

        try {
          sessionStorage.setItem(announcementBarStorageKey, announcementId)
        } catch {
          // Ignore storage failures and still hide the bar for this page view.
        }
      })
    })
  }

  setupAnnouncementBars()
  document.addEventListener('astro:page-load', setupAnnouncementBars)
</script>
