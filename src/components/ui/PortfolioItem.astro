---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  featureText: string
  reversed?: boolean
  imageSrc?: ImageMetadata
  imageAlt?: string
  accentColor?: string
  cardBackgroundColor?: string
  cardTextColor?: string
  title: string
  description: string
}

const {
  featureText,
  reversed = false,
  imageSrc,
  imageAlt = 'Portfolio preview image',
  accentColor = 'var(--color-primary)',
  cardBackgroundColor = 'var(--color-base-100)',
  cardTextColor = 'var(--color-base-content)',
  title,
  description,
} = Astro.props

const fallbackImageClasses =
  'h-full w-full bg-[radial-gradient(circle_at_30%_30%,var(--color-base-100),transparent_58%),linear-gradient(135deg,var(--color-base-100),var(--color-base-200)_46%,var(--color-base-300)_74%,var(--color-primary))]'

const componentStyles = [
  `--portfolio-accent-color: ${accentColor};`,
  `--portfolio-card-background: ${cardBackgroundColor};`,
  `--portfolio-card-text: ${cardTextColor};`,
  `--portfolio-card-divider: color-mix(in srgb, ${cardTextColor} 12%, transparent);`,
  '--portfolio-border-duration: 900ms;',
  '--portfolio-border-delay: 300ms;',
  '--portfolio-card-duration: 900ms;',
  '--portfolio-card-delay: 600ms;',
].join(' ')
---

<article
  class="portfolio-item lsa no-repeat relative grid gap-8 [opacity:1] [transform:none] md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.15fr)] md:gap-10 md:pt-[2px]"
  style={componentStyles}
>
  <span
    class:list={[
      'portfolio-item__border absolute top-0 left-0 hidden h-[2px] w-full bg-[var(--portfolio-accent-color)] [transform:scaleX(0)] [will-change:transform] motion-reduce:[transform:scaleX(1)] md:block',
      reversed ? 'origin-right' : 'origin-left',
    ]}
    aria-hidden="true"></span>

  <div
    class:list={['space-y-4 md:pt-8 text-left', reversed && 'md:order-2']}
    set:html={featureText}
  />

  <div
    class:list={[
      'portfolio-item__card-reveal grid min-h-[22rem] [grid-template-rows:0fr] opacity-0 [will-change:grid-template-rows,opacity] sm:min-h-[25rem] md:min-h-[31rem] motion-reduce:[grid-template-rows:1fr] motion-reduce:opacity-100',
      reversed && 'md:order-1',
    ]}
  >
    <div class="portfolio-item__card min-h-0 overflow-hidden">
      <div class="relative aspect-video overflow-hidden bg-base-200">
        {
          imageSrc ? (
            <Image src={imageSrc} alt={imageAlt} class="h-full w-full object-cover" />
          ) : (
            <div class={fallbackImageClasses} />
          )
        }
      </div>

      <div
        class="border-t border-[var(--portfolio-card-divider)] bg-[var(--portfolio-card-background)] p-5 text-left text-[var(--portfolio-card-text)] sm:p-7"
      >
        <h3 class="mb-2 text-sm font-extrabold uppercase tracking-wide">{title}</h3>
        <p class="max-w-none text-sm leading-relaxed sm:text-base">{description}</p>
      </div>
    </div>
  </div>
</article>

<style>
  /* Keep only the stateful animation hooks in CSS. Static styling lives in Tailwind classes above. */

  @media (min-width: 768px) {
    .portfolio-item.active .portfolio-item__border {
      animation: portfolio-border-draw var(--portfolio-border-duration)
        cubic-bezier(0.22, 1, 0.36, 1) var(--portfolio-border-delay) forwards;
    }
  }

  .portfolio-item.active .portfolio-item__card-reveal {
    animation: portfolio-card-grow var(--portfolio-card-duration) cubic-bezier(0.22, 1, 0.36, 1)
      var(--portfolio-card-delay) forwards;
  }

  @keyframes portfolio-border-draw {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes portfolio-card-grow {
    from {
      grid-template-rows: 0fr;
      opacity: 0;
    }

    to {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-item__border,
    .portfolio-item__card-reveal {
      animation: none !important;
    }
  }
</style>
