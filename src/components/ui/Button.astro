---
interface Props {
  label: string
  href?: string
  type?: 'submit' | 'button' | 'reset'
  tagClass?: string
  wrapperClass?: string
}

const { label, href, type = 'button', tagClass = '', wrapperClass = '' } = Astro.props

const Tag = href ? 'a' : 'button'
const attrs: Record<string, any> = href ? { href } : { type }
---

<div class={`flex ${wrapperClass}`}>
  <Tag
    {...attrs}
    class={`bg-base-100 border border-secondary focus:outline-none focus:bg-secondary hover:bg-secondary w-52 flex justify-between px-0 z-10 group cursor-pointer ${tagClass}`}
  >
    <span
      class="uppercase w-full p-4 font-extrabold leading-relaxed group-hover:text-base-100 group-focus:text-base-100 transition-colors duration-200"
    >
      {label}
    </span>
    <div
      class="w-1/3 h-full p-2 flex items-center bg-secondary fill-secondary-content group-hover:fill-base-100 group-focus:fill-base-100 transition-colors duration-200"
    >
      <svg
        class="-rotate-45 group-hover:rotate-0 group-focus:rotate-0 transition-transform duration-200"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
          clip-rule="evenodd"></path>
      </svg>
    </div>
  </Tag>
</div>
