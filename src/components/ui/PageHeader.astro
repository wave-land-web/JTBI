---
import type { MediaItem, VideoProps } from '../../sanity/lib/video'
import Button from './Button.astro'
import MuxVideo from './MuxVideo.astro'
import SanityImage from './SanityImage.astro'

interface Props {
  id?: string
  backgroundImageSrc?: string
  backgroundImageWidth?: number
  backgroundImageHeight?: number
  backgroundImageAlt?: string
  /** Ambient background video — takes precedence over the background image. */
  backgroundVideo?: VideoProps
  carouselImages?: MediaItem[]
  eyebrow?: string
  headline1?: string
  headline1Color?: 'dark' | 'light'
  headline2?: string
  headline2Color?: 'dark' | 'light'
  message?: string
  ctaLabel?: string
  ctaHref?: string
  title?: string
  srTitle?: string
  headerClass?: string
  contentClass?: string
}

const {
  id,
  backgroundImageSrc = '',
  backgroundImageWidth,
  backgroundImageHeight,
  backgroundImageAlt = '',
  backgroundVideo,
  carouselImages = [],
  eyebrow,
  headline1,
  headline1Color = 'light',
  headline2,
  headline2Color = 'light',
  message,
  ctaLabel,
  ctaHref,
  title,
  srTitle,
  headerClass = '',
  contentClass = '',
} = Astro.props

const hasCarousel = carouselImages.length > 0
---

<header
  id={id || undefined}
  class={`relative flex flex-col justify-center overflow-hidden pt-[calc(var(--nav-height)+var(--site-padding-3xl))] pb-(--site-padding-3xl) ${headerClass || ''}`}
>
  {
    backgroundVideo && !hasCarousel ? (
      <MuxVideo
        playbackId={backgroundVideo.playbackId}
        mode="ambient"
        poster={backgroundImageSrc || backgroundVideo.poster}
        class="select-none"
      />
    ) : (
      backgroundImageSrc &&
      backgroundImageWidth &&
      backgroundImageHeight &&
      !hasCarousel && (
        <SanityImage
          src={backgroundImageSrc}
          alt={backgroundImageAlt}
          class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
          width={backgroundImageWidth}
          height={backgroundImageHeight}
          priority
        />
      )
    )
  }

  <div class={`relative z-40 flex flex-col items-center gap-3 wrapper ${contentClass || ''}`}>
    {
      hasCarousel && (
        <div class="hero-carousel swiper absolute inset-0 pointer-events-none select-none">
          <div class="swiper-wrapper">
            {carouselImages.map((item) => (
              <div
                class="swiper-slide relative"
                data-swiper-autoplay={
                  item.kind === 'video' && item.duration
                    ? Math.max(4000, Math.round(item.duration * 1000))
                    : undefined
                }
              >
                {item.kind === 'video' ? (
                  <MuxVideo
                    playbackId={item.playbackId}
                    mode="ambient"
                    objectFit="contain"
                    poster={item.poster}
                    preload="metadata"
                    class="select-none"
                  />
                ) : (
                  <SanityImage
                    src={item.src}
                    alt={item.alt}
                    class="block h-full w-full object-contain"
                    width={item.width}
                    height={item.height}
                    priority
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }

    {eyebrow && <p class="eyebrow lsa no-repeat">{eyebrow}</p>}
    {srTitle && <h1 class="sr-only">{srTitle}</h1>}
    {title && <h1 class="h3 lsa no-repeat">{title}</h1>}
    {
      (headline1 || headline2) && (
        <h2
          class={`flex flex-col gap-3 headline lsa no-repeat lsa-slide-up ${headline1Color === 'dark' ? 'text-primary' : 'text-base-100'}`}
        >
          {headline1}
          {headline2 && (
            <>
              <br />
              <span
                class={`h1 block lsa no-repeat lsa-slide-up delay-100 ${headline2Color === 'dark' ? 'text-primary' : 'text-base-300'}`}
              >
                {headline2}
              </span>
            </>
          )}
        </h2>
      )
    }
    {message && <p class="lsa lsa-slide-up delay-100 no-repeat">{message}</p>}
    {
      ctaLabel && ctaHref && (
        <Button
          label={ctaLabel}
          href={ctaHref}
          wrapperClass="justify-center lsa lsa-slide-up delay-200 no-repeat"
        />
      )
    }
    <slot />
  </div>
</header>

<style>
  .hero-carousel.swiper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: clamp(100%, 70vh, 720px);
    z-index: -1;
  }
  .hero-carousel .swiper-slide {
    height: 100%;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .hero-carousel .swiper-slide-active {
    opacity: 1;
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Autoplay, EffectFade } from 'swiper/modules'
  import 'swiper/css'
  import 'swiper/css/effect-fade'

  type AmbientPlayer = HTMLElement & {
    play?: () => void
    pause?: () => void
    currentTime?: number
  }

  // The fade effect keeps every slide mounted (just at opacity 0), so without
  // this only-the-active-slide gating, every carousel video would stream and
  // play simultaneously for the lifetime of the page. Removing the autoplay
  // attribute hands playback control to this sync (and stops late `loadeddata`
  // autoplay from re-starting a paused slide); resetting currentTime makes a
  // video slide start from the top each time it rotates back in.
  function syncCarouselVideos(swiper: Swiper) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    swiper.slides.forEach((slide) => {
      const player = slide.querySelector<AmbientPlayer>('mux-player')
      if (!player) return
      player.removeAttribute('autoplay')
      if (slide.classList.contains('swiper-slide-active')) {
        if (typeof player.currentTime === 'number') player.currentTime = 0
        if (!reduceMotion) player.play?.()
      } else {
        player.pause?.()
      }
    })
  }

  function initHeroCarousel() {
    const heroCarousel = document.querySelector<HTMLElement>('.hero-carousel')
    if (!heroCarousel) return

    new Swiper(heroCarousel, {
      modules: [Autoplay, EffectFade],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      autoplay: { delay: 4000, disableOnInteraction: false },
      speed: 1500,
      loop: true,
      allowTouchMove: false,
      on: {
        afterInit: (swiper) => {
          customElements.whenDefined('mux-player').then(() => syncCarouselVideos(swiper))
        },
        slideChangeTransitionStart: syncCarouselVideos,
      },
    })
  }

  initHeroCarousel()
  document.addEventListener('astro:after-swap', () => {
    initHeroCarousel()
  })
</script>
