---
import { Image } from 'astro:assets'
import Button from './Button.astro'

interface Props {
  id?: string
  backgroundImageSrc?: string
  backgroundImageAlt?: string
  eyebrow?: string
  headline1?: string
  headline1Color?: 'dark' | 'light'
  headline2?: string
  headline2Color?: 'dark' | 'light'
  message?: string
  ctaLabel?: string
  ctaHref?: string
  title?: string
  srTitle?: string
  fullHeight?: boolean
  headerClass?: string
  contentClass?: string
}

const {
  id,
  backgroundImageSrc,
  backgroundImageAlt = '',
  eyebrow,
  headline1,
  headline1Color = 'light',
  headline2,
  headline2Color = 'light',
  message,
  ctaLabel,
  ctaHref,
  title,
  srTitle,
  fullHeight = true,
  headerClass = '',
  contentClass = ''
} = Astro.props
---

<header
  id={id || undefined}
  class={`relative flex justify-center items-center max-w-none overflow-hidden ${fullHeight || backgroundImageSrc ? 'h-screen' : ''} ${headerClass || ''}`}
>
  {backgroundImageSrc && (
    <Image
      src={backgroundImageSrc}
      alt={backgroundImageAlt}
      class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
      inferSize
    />
    <div class="page-header__overlay absolute inset-0" style="background-color: rgb(0 0 0 / var(--overlay-opacity, 0.3));" aria-hidden="true" />
  )}
  
  <div class={`relative wrapper z-40 ${contentClass || ''}`}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    {srTitle && <h1 class="sr-only">{srTitle}</h1>}
    {title && <h1>{title}</h1>}
    {(headline1 || headline2) && (
      <h2
        class={`flex flex-col gap-3 headline lsa no-repeat lsa-slide-up delay-100 ${headline1Color === 'dark' ? 'text-primary' : 'text-base-100'}`}
      >
        {headline1}
        {headline2 && (
          <br />
          <span
            class={`h1 block lsa no-repeat lsa-slide-up delay-200 ${headline2Color === 'dark' ? 'text-primary' : 'text-base-300'}`}
          >
            {headline2}
          </span>
        )}
      </h2>
    )}
    {message && <p class="h4 mb-16 lsa no-repeat">{message}</p>}
    {ctaLabel && ctaHref && (
      <Button label={ctaLabel!} href={ctaHref} wrapperClass="justify-center" />
    )}
    <slot />
  </div>
</header>

<script>
  function initOverlayScroll() {
    const headers = document.querySelectorAll<HTMLElement>('header:has(.page-header__overlay)')

    headers.forEach((header) => {
      const overlay = header.querySelector<HTMLElement>('.page-header__overlay')
      if (!overlay) return

      const update = () => {
        const rect = header.getBoundingClientRect()
        const headerHeight = header.offsetHeight
        const scrolled = Math.max(0, -rect.top)
        const progress = Math.min(scrolled / headerHeight, 1)
        const opacity = 0.3 + progress * 0.7
        overlay.style.setProperty('--overlay-opacity', String(opacity))
      }

      window.addEventListener('scroll', update, { passive: true })
      update()
    })
  }

  initOverlayScroll()
  document.addEventListener('astro:after-swap', initOverlayScroll)
</script>

