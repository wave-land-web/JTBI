---
type LightboxButtonType = 'close' | 'prev' | 'next'

interface Props {
  type: LightboxButtonType
  class?: string
}

const { type, class: className } = Astro.props

const ICON_PATHS: Record<LightboxButtonType, string> = {
  close: 'M6 18 18 6M6 6l12 12',
  prev: 'M15.75 19.5 8.25 12l7.5-7.5',
  next: 'm8.25 4.5 7.5 7.5-7.5 7.5',
}

const LABELS: Record<LightboxButtonType, string> = {
  close: 'Close',
  prev: 'Previous image',
  next: 'Next image',
}
---

<button
  type="button"
  class:list={['btn btn-circle btn-neutral z-10', className]}
  {...{ [`data-lightbox-${type}`]: '' }}
  aria-label={LABELS[type]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    class="w-6 h-6"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d={ICON_PATHS[type]}></path>
  </svg>
</button>
