---
/**
 * Centered play-triangle overlay for video tiles in grids/galleries.
 * Purely decorative — the wrapping button's aria-label announces the video.
 */
---

<span
  aria-hidden="true"
  class="absolute inset-0 z-10 flex items-center justify-center pointer-events-none"
>
  <span
    class="flex items-center justify-center w-12 h-12 rounded-full bg-neutral/60 text-base-100 transition-transform duration-200 group-hover:scale-110"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-0.5">
      <path d="M8 5v14l11-7z"></path>
    </svg>
  </span>
</span>
