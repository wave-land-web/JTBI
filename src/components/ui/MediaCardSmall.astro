---
import type { ImageMetadata } from 'astro'
import Card from './Card.astro'

export interface Props {
  title: string
  description: string
  href?: string
  ctaLabel?: string
  imageSrc?: ImageMetadata
  imageAlt?: string
  accentColor?: string
  cardBackgroundColor?: string
  cardTextColor?: string
  titleColor?: string
  mediaBackgroundColor?: string
}

const {
  title,
  description,
  href = '#contact',
  ctaLabel = 'Example',
  imageSrc,
  imageAlt = '',
  accentColor = 'var(--color-primary)',
  cardBackgroundColor = `color-mix(in srgb, ${accentColor} 10%, transparent)`,
  cardTextColor = accentColor,
  titleColor = accentColor,
  mediaBackgroundColor = 'var(--color-base-200)',
} = Astro.props

const cardStyles = `
  --service-accent-color: ${accentColor};
  --service-card-background: ${cardBackgroundColor};
  --service-card-text: ${cardTextColor};
  --service-title-color: ${titleColor};
  --service-cta-color: ${cardTextColor};
  --service-media-background: ${mediaBackgroundColor};
  --service-card-divider: color-mix(in srgb, ${cardTextColor} 14%, transparent);
  --service-border-duration: 1000ms;
  --service-border-delay: 300ms;
  --service-card-duration: 1000ms;
  --service-card-delay: 600ms;
`
---

<article class="service-card relative lsa no-repeat w-full" style={cardStyles}>
  <span
    class="service-card__border absolute left-0 top-0 h-full w-0.75 bg-(--service-accent-color) transform-[scaleY(0)] origin-top will-change-transform motion-reduce:transform-[scaleY(1)]"
    aria-hidden="true"></span>

  <div class="h-full service-card__reveal overflow-hidden pl-0.75">
    <div
      class="h-full service-card__panel group block opacity-0 origin-left transform-[scaleX(0)] motion-reduce:opacity-100 motion-reduce:transform-none bg-(--service-card-background)"
    >
      <Card
        title={title}
        description={description}
        imageSrc={imageSrc}
        imageAlt={imageAlt}
        imageAspect="square"
        imageClass="relative z-10 h-full w-full object-contain p-7"
        mediaClass="bg-(--service-media-background)"
        contentClass="flex flex-col gap-2.5 p-4 text-left sm:p-5"
        class="h-full border-l-0 border-(--service-card-divider) text-(--service-card-text)"
        href={href}
        ctaLabel={ctaLabel}
      />
    </div>
  </div>
</article>

<style>
  .service-card.active .service-card__border {
    animation: service-border-draw var(--service-border-duration) cubic-bezier(0.22, 1, 0.36, 1)
      var(--service-border-delay) forwards;
  }

  .service-card.active .service-card__panel {
    animation: service-card-reveal var(--service-card-duration) cubic-bezier(0.22, 1, 0.36, 1)
      var(--service-card-delay) forwards;
  }

  @keyframes service-border-draw {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  @keyframes service-card-reveal {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @supports (clip-path: inset(0 100% 0 0)) {
    .service-card__panel {
      clip-path: inset(0 100% 0 0);
      transform: none;
      will-change: clip-path, opacity;
    }

    .service-card.active .service-card__panel {
      animation-name: service-card-reveal-clipped;
    }

    @keyframes service-card-reveal-clipped {
      from {
        opacity: 0;
        clip-path: inset(0 100% 0 0);
      }

      to {
        opacity: 1;
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__border,
    .service-card__panel {
      animation: none !important;
    }

    .service-card__panel {
      clip-path: none;
      will-change: auto;
    }
  }
</style>
