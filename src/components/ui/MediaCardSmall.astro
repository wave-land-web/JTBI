---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

export interface Props {
  title: string
  description: string
  href?: string
  ctaLabel?: string
  imageSrc?: ImageMetadata
  imageAlt?: string
  accentColor?: string
  cardBackgroundColor?: string
  cardTextColor?: string
  titleColor?: string
  bodyTextColor?: string
  ctaColor?: string
  mediaBackgroundColor?: string
}

const {
  title,
  description,
  href = '#contact',
  ctaLabel = 'Example',
  imageSrc,
  imageAlt = '',
  accentColor = 'var(--color-primary)',
  cardBackgroundColor = 'var(--color-base-100)',
  cardTextColor = 'var(--color-base-content)',
  titleColor = cardTextColor,
  bodyTextColor = cardTextColor,
  ctaColor = cardTextColor,
  mediaBackgroundColor = 'var(--color-base-200)',
} = Astro.props

const cardStyles = [
  `--service-accent-color: ${accentColor};`,
  `--service-card-background: ${cardBackgroundColor};`,
  `--service-card-text: ${cardTextColor};`,
  `--service-title-color: ${titleColor};`,
  `--service-body-color: ${bodyTextColor};`,
  `--service-cta-color: ${ctaColor};`,
  `--service-media-background: ${mediaBackgroundColor};`,
  `--service-card-divider: color-mix(in srgb, ${cardTextColor} 14%, transparent);`,
  '--service-border-duration: 600ms;',
  '--service-border-delay: 300ms;',
  '--service-card-duration: 600ms;',
  '--service-card-delay: 600ms;',
].join(' ')
---

<article class="service-card relative lsa no-repeat w-full" style={cardStyles}>
  <span
    class="service-card__border absolute left-0 top-0 h-full w-px bg-(--service-accent-color) transform-[scaleY(0)] origin-top will-change-transform motion-reduce:transform-[scaleY(1)]"
    aria-hidden="true"></span>

  <div class="h-full service-card__reveal overflow-hidden pl-px">
    <a
      href={href}
      class="h-full service-card__panel group block opacity-0 origin-left transform-[scaleX(0)] motion-reduce:opacity-100 motion-reduce:transform-none"
    >
      <div
        class="h-full border border-l-0 border-(--service-card-divider) bg-(--service-card-background) text-(--service-card-text)"
      >
        <div class="relative aspect-square overflow-hidden bg-(--service-media-background)">
          {
            imageSrc && (
              <Image
                src={imageSrc}
                alt={imageAlt}
                class="relative z-10 h-full w-full object-contain p-7"
              />
            )
          }
        </div>

        <div class="flex flex-col gap-2.5 p-4 text-left sm:p-5">
          <h4
            class="font-radio-canada text-2xl font-semibold uppercase text-(--service-title-color)"
          >
            {title}
          </h4>
          <p class="font-factoria font-semibold text-(--service-body-color)">
            {description}
          </p>
          <p
            class="group ml-auto text-sm font-semibold uppercase tracking-widest text-(--service-cta-color)"
          >
            <span class="link group-hover:link-hover">
              {ctaLabel}
            </span>
            <span class="text-xl">»</span>
          </p>
        </div>
      </div>
    </a>
  </div>
</article>

<style>
  .service-card.active .service-card__border {
    animation: service-border-draw var(--service-border-duration) cubic-bezier(0.22, 1, 0.36, 1)
      var(--service-border-delay) forwards;
  }

  .service-card.active .service-card__panel {
    animation: service-card-reveal var(--service-card-duration) cubic-bezier(0.22, 1, 0.36, 1)
      var(--service-card-delay) forwards;
  }

  @keyframes service-border-draw {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }

  @keyframes service-card-reveal {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @supports (clip-path: inset(0 100% 0 0)) {
    .service-card__panel {
      clip-path: inset(0 100% 0 0);
      transform: none;
      will-change: clip-path, opacity;
    }

    .service-card.active .service-card__panel {
      animation-name: service-card-reveal-clipped;
    }

    @keyframes service-card-reveal-clipped {
      from {
        opacity: 0;
        clip-path: inset(0 100% 0 0);
      }

      to {
        opacity: 1;
        clip-path: inset(0 0 0 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__border,
    .service-card__panel {
      animation: none !important;
    }

    .service-card__panel {
      clip-path: none;
      will-change: auto;
    }
  }
</style>
